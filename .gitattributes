# Pin line endings so STA-Training-Hub.html and its dist/index.html copy never
# drift on EOL. EOL drift makes the byte-identity check (and plain copies) fail
# and invites full-file rewrites -- the mechanism behind the recurring
# truncated/blank-page bug. All text is normalized to LF in the repo.
* text=auto eol=lf

*.html  text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf
*.ps1   text eol=lf
*.py    text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# Binary assets: never normalize or touch.
*.docx binary
*.pptx binary
*.xlsx binary
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
